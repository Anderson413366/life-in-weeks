# Active Supabase project. These are required for local dev and Vercel builds.
# The anon key is browser-safe when Row Level Security policies are correctly configured.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Do not add SUPABASE_SERVICE_ROLE_KEY to Vite/browser env files.
# Service role keys are server-only and this app has no server runtime today.
